{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nikmar0808/eai-backend-poc/blob/develop/docs/api/events/readings-stored.schema.json",
  "title": "ReadingsStored",
  "description": "One batch of meter readings that python-validator has just stored. Only readings really stored are listed: duplicates and repeated requests produce no event.",
  "type": "object",
  "required": ["event_id", "occurred_at", "meter_id", "grid_zone", "readings"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "description": "A new UUID for every event. Consumers use it to skip an event they have already processed.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "occurred_at": {
      "description": "When the readings were stored: the moment the producer's transaction ran, in UTC.",
      "type": "string",
      "format": "date-time"
    },
    "meter_id": {
      "description": "The meter. Also the Kafka key, so one meter's events stay in order.",
      "type": "string",
      "minLength": 5,
      "maxLength": 20,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "grid_zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/Reading" }
    }
  },
  "definitions": {
    "Reading": {
      "type": "object",
      "required": ["timestamp", "kwh_value", "voltage"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "description": "The reading's moment, in UTC.", "type": "string", "format": "date-time" },
        "kwh_value": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "voltage": { "description": "Always present; null when the meter sent none.", "type": ["number", "null"], "minimum": 100, "maximum": 300 }
      }
    }
  }
}
